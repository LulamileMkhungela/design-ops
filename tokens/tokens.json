{
  "$schema": "https://design-tokens.org/schema.json",
  "$meta": {
    "name": "designops-tokens",
    "version": "3.0.0",
    "owner": "Lulamile Mkhungela",
    "source": "Exported from Figma Variables — DO NOT EDIT BY HAND. Edit in Figma, re-export, open a PR."
  },
  "color": {
    "primary": {
      "50":  { "$value": "#f9ffe0", "$type": "color", "$description": "Primary 50 — subtle tint, hover washes" },
      "800": { "$value": "#d5ef48", "$type": "color", "$description": "Primary 800 — hover state of 900" },
      "900": { "$value": "#e8ff5a", "$type": "color", "$description": "Primary 900 — brand accent (default)" }
    },
    "neutral": {
      "900": { "$value": "#0d0d0b", "$type": "color", "$description": "Neutral 900 — app background / ink on accent" },
      "800": { "$value": "#141412", "$type": "color", "$description": "Neutral 800 — raised background" },
      "700": { "$value": "#1e1e1b", "$type": "color", "$description": "Neutral 700 — surface" },
      "600": { "$value": "#2a2a26", "$type": "color", "$description": "Neutral 600 — surface hover" }
    },
    "ink": {
      "default": { "$value": "#f0ede6", "$type": "color", "$description": "Default ink on dark surfaces" },
      "muted":   { "$value": "rgba(240,237,230,.7)", "$type": "color", "$description": "Secondary ink" },
      "subtle":  { "$value": "rgba(240,237,230,.45)", "$type": "color", "$description": "Hints, placeholders" }
    },
    "danger":  { "600": { "$value": "#dd4040", "$type": "color", "$description": "Destructive actions, errors" } },
    "success": { "600": { "$value": "#4ade80", "$type": "color", "$description": "Positive confirmations" } },
    "warning": { "600": { "$value": "#fbbf24", "$type": "color", "$description": "Caution, pending states" } },
    "info":    { "600": { "$value": "#60a5fa", "$type": "color", "$description": "Neutral information" } }
  },
  "space": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "7": { "$value": "32px", "$type": "dimension" },
    "8": { "$value": "40px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "typography": {
    "size": {
      "xs":   { "$value": "0.75rem",  "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem",     "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.5rem",   "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 1px 4px rgba(0,0,0,.2)",  "$type": "shadow" },
    "md": { "$value": "0 4px 16px rgba(0,0,0,.3)", "$type": "shadow" },
    "lg": { "$value": "0 8px 32px rgba(0,0,0,.4)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "220ms", "$type": "duration" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(.22,1,.36,1)", "$type": "cubicBezier" }
    }
  }
}
